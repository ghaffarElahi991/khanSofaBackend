{
  "name": "khan-sofa-backend",
  "version": "1.0.0",
  "description": "Node.js API for the Khan Sofa furniture store",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "db:create": "tsx scripts/create-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-tags": "tsx scripts/seed-tags.ts",
    "db:import": "tsx scripts/import-csv.ts",
    "db:import:fresh": "tsx scripts/import-csv.ts --fresh",
    "db:migrate-orders": "tsx scripts/migrate-order-billing.ts",
    "db:migrate-stripe": "tsx scripts/migrate-stripe.ts",
    "db:migrate-furniture": "tsx scripts/migrate-furniture-details.ts",
    "db:setup": "npm run db:create && npm run db:push && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.22.0",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
