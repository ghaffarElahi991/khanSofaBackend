<%
  const hasSubmittedValues = formValues && Object.keys(formValues).length > 0;
  const values = hasSubmittedValues ? formValues : (product || {});
  const getValue = (key, fallback = '') => values[key] !== undefined && values[key] !== null ? values[key] : fallback;
  const listValue = (key, fallback = '') => Array.isArray(values[key]) ? values[key].join(', ') : getValue(key, fallback);
  const isChecked = (key) => hasSubmittedValues ? values[key] === 'on' : Boolean(values[key]);
  const selectedTags = new Set(selectedTagIds.map(Number));
  const editing = Boolean(product && product.id);
  const submittedImageUrls = Array.isArray(values.imageUrls)
    ? values.imageUrls
    : (values.imageUrls ? [values.imageUrls] : []);
  const savedImageUrls = Array.isArray(values.images) && values.images.length
    ? values.images
    : [values.primaryImageUrl, values.secondaryImageUrl].filter(Boolean);
  const imageUrls = (submittedImageUrls.length ? submittedImageUrls : savedImageUrls).length
    ? (submittedImageUrls.length ? submittedImageUrls : savedImageUrls)
    : [''];
%>

<style>
  .editor-section { padding:1.4rem; }
  .editor-section + .editor-section { border-top:1px solid var(--admin-line); }
  .section-icon { align-items:center; background:#e8eee9; border-radius:10px; color:var(--admin-green); display:flex; flex:0 0 auto; height:38px; justify-content:center; width:38px; }
  .section-title { font-family:"DM Sans",sans-serif; font-size:.98rem; font-weight:800; margin:0; }
  .input-group-text { border-color:#d6d3ca; color:#6d746f; }
  .form-switch .form-check-input { height:1.25rem; width:2.35rem; }
  .form-check-input:checked { background-color:var(--admin-green); border-color:var(--admin-green); }
  .tag-option { background:#faf9f5; border:1px solid #e4e1d9; border-radius:10px; cursor:pointer; display:block; padding:.6rem .7rem; transition:.15s ease; }
  .tag-option:has(input:checked) { background:#e8eee9; border-color:#93a99e; color:var(--admin-green); }
  .suggestion-chip { background:#f7f5f0; border:1px solid #dedbd2; border-radius:99px; color:#525a55; font-size:.72rem; padding:.3rem .55rem; }
  .suggestion-chip:hover { background:#e8eee9; border-color:#aebeb6; color:var(--admin-green); }
  .image-preview { aspect-ratio:4/3; background:#efede7; border:1px dashed #cac6bc; border-radius:12px; display:block; object-fit:cover; width:100%; }
  .image-preview-wrap { position:relative; }
  .image-number { background:rgba(31,58,46,.88); border-radius:99px; color:#fff; font-size:.7rem; font-weight:700; left:.65rem; padding:.3rem .55rem; position:absolute; top:.65rem; }
  .remove-image { position:absolute; right:.65rem; top:.65rem; }
  .editor-sidebar { position:sticky; top:1rem; }
  .required::after { color:#a43d36; content:" *"; }
  @media (max-width:991.98px) { .editor-sidebar{position:static} }
</style>

<form method="POST" action="<%= editing ? '/admin/products/' + product.id : '/admin/products' %>" id="productForm">
  <input type="hidden" name="csrf" value="<%= csrf %>">

  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <a href="/admin/products" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to products</a>
      <p class="eyebrow mb-2 mt-3"><%= editing ? 'Catalogue · Edit' : 'Catalogue · New item' %></p>
      <h1 class="display-6 mb-1"><%= editing ? 'Edit furniture' : 'Add furniture' %></h1>
      <p class="text-muted mb-0">Use accurate details so customers can compare, measure, and buy confidently.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i><%= editing ? 'Save changes' : 'Create product' %></button>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert"><i class="bi bi-exclamation-circle-fill mt-1"></i><div><strong>Couldn’t save the product.</strong><div><%= error %></div></div></div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card overflow-hidden mb-4">
        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-card-text"></i></span><div><h2 class="section-title">Basic information</h2><p class="small text-muted mb-0">The product name and story shown to customers.</p></div></div>
          <div class="row g-3">
            <div class="col-md-8"><label for="name" class="form-label required">Product name</label><input id="name" type="text" name="name" class="form-control" maxlength="140" value="<%= getValue('name') %>" placeholder="e.g. Sofia Three-Seat Sofa" required></div>
            <div class="col-md-4"><label for="sku" class="form-label">SKU</label><input id="sku" type="text" name="sku" class="form-control text-uppercase" maxlength="60" value="<%= getValue('sku') %>" placeholder="KS-SOF-001"><div class="form-text">Unique internal stock code</div></div>
            <div class="col-md-6"><label for="brand" class="form-label required">Brand / collection</label><input id="brand" type="text" name="brand" class="form-control" value="<%= getValue('brand', 'Khan Studio') %>" placeholder="Khan Studio" required></div>
            <div class="col-md-6"><label for="categoryId" class="form-label required">Store category</label><select id="categoryId" name="categoryId" class="form-select" required><option value="">Choose category</option><% categories.forEach(function(cat) { %><option value="<%= cat.id %>" <%= Number(getValue('categoryId')) === cat.id ? 'selected' : '' %>><%= cat.name %></option><% }); %></select></div>
            <div class="col-12"><label for="shortDescription" class="form-label required">Short description</label><input id="shortDescription" type="text" name="shortDescription" class="form-control" maxlength="220" value="<%= getValue('shortDescription') %>" placeholder="One clear line about comfort, material, and use" required></div>
            <div class="col-12"><label for="description" class="form-label required">Full description</label><textarea id="description" name="description" class="form-control" rows="5" placeholder="Describe the design, comfort, construction, and ideal room..." required><%= getValue('description') %></textarea></div>
          </div>
        </section>

        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-grid-1x2"></i></span><div><h2 class="section-title">Furniture classification</h2><p class="small text-muted mb-0">Makes catalogue filtering and navigation more useful.</p></div></div>
          <div class="row g-3">
            <div class="col-md-6"><label for="furnitureType" class="form-label required">Furniture type</label><select id="furnitureType" name="furnitureType" class="form-select" required><option value="">Choose furniture type</option><% furnitureTypes.forEach(function(option) { %><option value="<%= option %>" <%= getValue('furnitureType') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
            <div class="col-md-6"><label for="room" class="form-label required">Best suited room</label><select id="room" name="room" class="form-select" required><option value="">Choose room</option><% rooms.forEach(function(option) { %><option value="<%= option %>" <%= getValue('room') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
          </div>
        </section>

        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-rulers"></i></span><div><h2 class="section-title">Dimensions & capacity</h2><p class="small text-muted mb-0">All measurements are in centimetres and weights in kilograms.</p></div></div>
          <div class="row g-3">
            <div class="col-6 col-md-3"><label for="widthCm" class="form-label required">Width</label><div class="input-group"><input id="widthCm" type="number" name="widthCm" min="0.01" step="0.01" class="form-control dimension-field" value="<%= getValue('widthCm') %>" required><span class="input-group-text">cm</span></div></div>
            <div class="col-6 col-md-3"><label for="depthCm" class="form-label required">Depth</label><div class="input-group"><input id="depthCm" type="number" name="depthCm" min="0.01" step="0.01" class="form-control dimension-field" value="<%= getValue('depthCm') %>" required><span class="input-group-text">cm</span></div></div>
            <div class="col-6 col-md-3"><label for="heightCm" class="form-label required">Height</label><div class="input-group"><input id="heightCm" type="number" name="heightCm" min="0.01" step="0.01" class="form-control dimension-field" value="<%= getValue('heightCm') %>" required><span class="input-group-text">cm</span></div></div>
            <div class="col-6 col-md-3"><label for="seatHeightCm" class="form-label">Seat height</label><div class="input-group"><input id="seatHeightCm" type="number" name="seatHeightCm" min="0" step="0.01" class="form-control" value="<%= getValue('seatHeightCm') %>"><span class="input-group-text">cm</span></div></div>
            <div class="col-12"><label for="dimensions" class="form-label">Display dimensions</label><input id="dimensions" type="text" name="dimensions" class="form-control" value="<%= getValue('dimensions') %>" placeholder="Generated from width, depth, and height"><div class="form-text">You can add a note such as “Queen” or “per module”.</div></div>
            <div class="col-6 col-md-3"><label for="seatingCapacity" class="form-label">Seating capacity</label><div class="input-group"><input id="seatingCapacity" type="number" name="seatingCapacity" min="1" step="1" class="form-control" value="<%= getValue('seatingCapacity') %>"><span class="input-group-text">people</span></div></div>
            <div class="col-6 col-md-3"><label for="weightKg" class="form-label">Product weight</label><div class="input-group"><input id="weightKg" type="number" name="weightKg" min="0" step="0.01" class="form-control" value="<%= getValue('weightKg') %>"><span class="input-group-text">kg</span></div></div>
            <div class="col-6 col-md-3"><label for="maxLoadKg" class="form-label">Maximum load</label><div class="input-group"><input id="maxLoadKg" type="number" name="maxLoadKg" min="0" step="0.01" class="form-control" value="<%= getValue('maxLoadKg') %>"><span class="input-group-text">kg</span></div></div>
          </div>
        </section>

        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-layers"></i></span><div><h2 class="section-title">Materials & construction</h2><p class="small text-muted mb-0">Include upholstery, inner structure, filling, and finish.</p></div></div>
          <div class="row g-3">
            <div class="col-12"><label for="material" class="form-label required">Material summary</label><input id="material" type="text" name="material" class="form-control" value="<%= getValue('material') %>" placeholder="Performance linen, kiln-dried hardwood, foam and feather" required></div>
            <div class="col-md-6"><label for="upholsteryMaterial" class="form-label">Cloth / upholstery type</label><select id="upholsteryMaterial" name="upholsteryMaterial" class="form-select"><option value="">Choose upholstery</option><% upholsteryMaterials.forEach(function(option) { %><option value="<%= option %>" <%= getValue('upholsteryMaterial') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
            <div class="col-md-6"><label for="frameMaterial" class="form-label">Frame / structure</label><select id="frameMaterial" name="frameMaterial" class="form-select"><option value="">Choose frame material</option><% frameMaterials.forEach(function(option) { %><option value="<%= option %>" <%= getValue('frameMaterial') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
            <div class="col-md-6"><label for="cushionFilling" class="form-label">Cushion filling</label><select id="cushionFilling" name="cushionFilling" class="form-select"><option value="">Choose filling</option><% cushionFillings.forEach(function(option) { %><option value="<%= option %>" <%= getValue('cushionFilling') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
            <div class="col-md-6"><label for="finish" class="form-label">Surface finish</label><select id="finish" name="finish" class="form-select"><option value="">Choose finish</option><% finishes.forEach(function(option) { %><option value="<%= option %>" <%= getValue('finish') === option ? 'selected' : '' %>><%= option %></option><% }); %></select></div>
          </div>
        </section>

        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-palette"></i></span><div><h2 class="section-title">Colours & configurations</h2><p class="small text-muted mb-0">Comma-separated choices become selectable options on the storefront.</p></div></div>
          <div class="mb-3"><label for="colors" class="form-label">Available colours</label><input id="colors" type="text" name="colors" class="form-control" value="<%= listValue('colors') %>" placeholder="Oatmeal, Sage, Charcoal"><div class="d-flex flex-wrap gap-1 mt-2"><% ['Natural', 'Oatmeal', 'Ivory', 'Walnut', 'Charcoal', 'Sage'].forEach(function(item) { %><button class="suggestion-chip" type="button" data-add-to="colors" data-value="<%= item %>">+ <%= item %></button><% }); %></div></div>
          <div><label for="configurations" class="form-label">Sizes / configurations</label><input id="configurations" type="text" name="configurations" class="form-control" value="<%= listValue('configurations', 'Standard') %>" placeholder="2 Seater, 3 Seater, Left Chaise"><div class="d-flex flex-wrap gap-1 mt-2"><% ['Standard', '2 Seater', '3 Seater', 'Left Chaise', 'Right Chaise', 'Queen', 'King', 'Set of Two'].forEach(function(item) { %><button class="suggestion-chip" type="button" data-add-to="configurations" data-value="<%= item %>">+ <%= item %></button><% }); %></div></div>
        </section>
      </div>

      <div class="card overflow-hidden mb-4">
        <section class="editor-section">
          <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-tags"></i></span><div><h2 class="section-title">Shop filters & style tags</h2><p class="small text-muted mb-0">Choose every tag that should help customers discover this item.</p></div></div>
          <div class="row g-4">
            <% tagGroups.forEach(function(group) { %>
              <div class="col-md-6">
                <h3 class="small fw-bold mb-2"><%= group.name %></h3>
                <div class="row g-2">
                  <% group.tags.forEach(function(tag) { %><div class="col-6"><label class="tag-option small"><input class="form-check-input me-2" type="checkbox" name="tagIds" value="<%= tag.id %>" <%= selectedTags.has(tag.id) ? 'checked' : '' %>><%= tag.name %></label></div><% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        </section>
      </div>

      <div class="card overflow-hidden">
        <section class="editor-section">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div class="d-flex gap-3"><span class="section-icon"><i class="bi bi-images"></i></span><div><h2 class="section-title">Product images</h2><p class="small text-muted mb-0">The first image is the cover. Add as many gallery images as you need.</p></div></div>
            <button id="addImage" type="button" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add image</button>
          </div>
          <div id="imageFields" class="row g-3">
            <% imageUrls.forEach(function(imageUrl, index) { %>
              <div class="col-md-6 image-field" data-image-field>
                <div class="image-preview-wrap mb-3">
                  <img class="image-preview" data-image-preview src="<%= imageUrl %>" alt="Product image <%= index + 1 %> preview">
                  <span class="image-number" data-image-number><%= index === 0 ? 'Cover' : 'Image ' + (index + 1) %></span>
                  <button type="button" class="btn btn-light btn-sm remove-image shadow-sm" data-remove-image aria-label="Remove image"><i class="bi bi-trash"></i></button>
                </div>
                <label class="form-label <%= index === 0 ? 'required' : '' %>" data-image-label>Image URL <%= index + 1 %></label>
                <input type="url" name="imageUrls" class="form-control image-url" value="<%= imageUrl %>" placeholder="https://..." <%= index === 0 ? 'required' : '' %>>
              </div>
            <% }); %>
          </div>
        </section>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="editor-sidebar">
        <div class="card overflow-hidden mb-4">
          <section class="editor-section">
            <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-shop"></i></span><div><h2 class="section-title">Sales & inventory</h2><p class="small text-muted mb-0">Pricing and availability controls.</p></div></div>
            <div class="mb-3"><label for="status" class="form-label required">Publishing status</label><select id="status" name="status" class="form-select" required><% productStatuses.forEach(function(option) { %><option value="<%= option %>" <%= getValue('status', 'In Stock') === option ? 'selected' : '' %>><%= option %></option><% }); %></select><div class="form-text">Use Draft while product details are incomplete.</div></div>
            <div class="row g-3">
              <div class="col-7"><label for="price" class="form-label required">Price</label><div class="input-group"><span class="input-group-text">$</span><input id="price" type="number" name="price" step="0.01" min="0.01" class="form-control" value="<%= getValue('price') %>" required></div></div>
              <div class="col-5"><label for="stock" class="form-label required">Stock</label><input id="stock" type="number" name="stock" min="0" step="1" class="form-control" value="<%= getValue('stock', 0) %>" required></div>
            </div>
          </section>
          <section class="editor-section">
            <h2 class="section-title mb-3">Merchandising</h2>
            <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" name="isNewArrival" id="isNewArrival" <%= isChecked('isNewArrival') ? 'checked' : '' %>><label class="form-check-label fw-semibold ms-1" for="isNewArrival">New arrival</label><div class="small text-muted ms-1">Feature in the latest collection.</div></div>
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" name="isBestSeller" id="isBestSeller" <%= isChecked('isBestSeller') ? 'checked' : '' %>><label class="form-check-label fw-semibold ms-1" for="isBestSeller">Best seller</label><div class="small text-muted ms-1">Show a best-seller badge.</div></div>
          </section>
        </div>

        <div class="card overflow-hidden mb-4">
          <section class="editor-section">
            <div class="d-flex gap-3 mb-4"><span class="section-icon"><i class="bi bi-truck"></i></span><div><h2 class="section-title">Delivery & care</h2><p class="small text-muted mb-0">Set buyer expectations after purchase.</p></div></div>
            <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" name="assemblyRequired" id="assemblyRequired" <%= isChecked('assemblyRequired') ? 'checked' : '' %>><label class="form-check-label fw-semibold ms-1" for="assemblyRequired">Assembly required</label></div>
            <div class="mb-3"><label for="warrantyMonths" class="form-label required">Warranty</label><div class="input-group"><input id="warrantyMonths" type="number" name="warrantyMonths" min="0" step="1" class="form-control" value="<%= getValue('warrantyMonths', 12) %>" required><span class="input-group-text">months</span></div></div>
            <div><label for="careInstructions" class="form-label">Care instructions</label><textarea id="careInstructions" name="careInstructions" class="form-control" rows="5" placeholder="Vacuum weekly. Blot spills immediately..."><%= getValue('careInstructions') %></textarea></div>
          </section>
        </div>

        <details class="card mb-4">
          <summary class="editor-section fw-bold" style="cursor:pointer">Review score (optional)</summary>
          <div class="editor-section pt-0"><p class="small text-muted">Usually updated from customer reviews. Adjust only when importing existing data.</p><div class="row g-3"><div class="col-6"><label for="rating" class="form-label">Rating</label><input id="rating" type="number" name="rating" step="0.1" min="0" max="5" class="form-control" value="<%= getValue('rating', 0) %>"></div><div class="col-6"><label for="reviewCount" class="form-label">Reviews</label><input id="reviewCount" type="number" name="reviewCount" min="0" step="1" class="form-control" value="<%= getValue('reviewCount', 0) %>"></div></div></div>
        </details>

        <div class="card p-3">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2 me-2"></i><%= editing ? 'Save changes' : 'Create product' %></button>
          <a href="/admin/products" class="btn btn-link text-decoration-none mt-1">Cancel</a>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  (function () {
    const width = document.getElementById('widthCm');
    const depth = document.getElementById('depthCm');
    const height = document.getElementById('heightCm');
    const dimensions = document.getElementById('dimensions');
    document.querySelectorAll('.dimension-field').forEach(function (input) {
      input.addEventListener('input', function () {
        if (width.value && depth.value && height.value) dimensions.value = 'W ' + width.value + ' × D ' + depth.value + ' × H ' + height.value + ' cm';
      });
    });

    document.querySelectorAll('[data-add-to]').forEach(function (button) {
      button.addEventListener('click', function () {
        const target = document.getElementById(button.dataset.addTo);
        const values = target.value.split(',').map(function (item) { return item.trim(); }).filter(Boolean);
        if (!values.some(function (item) { return item.toLowerCase() === button.dataset.value.toLowerCase(); })) values.push(button.dataset.value);
        target.value = values.join(', ');
      });
    });

    const imageFields = document.getElementById('imageFields');
    const addImage = document.getElementById('addImage');

    function updateImageField(field) {
      const input = field.querySelector('.image-url');
      const preview = field.querySelector('[data-image-preview]');
      const updatePreview = function () {
        preview.src = input.value || '';
        preview.style.opacity = input.value ? '1' : '.25';
      };
      preview.addEventListener('error', function () { preview.style.opacity = '.25'; });
      preview.addEventListener('load', function () { preview.style.opacity = '1'; });
      input.addEventListener('input', updatePreview);
      updatePreview();
    }

    function renumberImages() {
      const fields = Array.from(imageFields.querySelectorAll('[data-image-field]'));
      fields.forEach(function (field, index) {
        const input = field.querySelector('.image-url');
        const label = field.querySelector('[data-image-label]');
        field.querySelector('[data-image-number]').textContent = index === 0 ? 'Cover' : 'Image ' + (index + 1);
        label.textContent = 'Image URL ' + (index + 1);
        label.classList.toggle('required', index === 0);
        input.required = index === 0;
        field.querySelector('[data-remove-image]').disabled = fields.length === 1;
      });
    }

    imageFields.querySelectorAll('[data-image-field]').forEach(updateImageField);
    imageFields.addEventListener('click', function (event) {
      const button = event.target.closest('[data-remove-image]');
      if (!button || imageFields.querySelectorAll('[data-image-field]').length === 1) return;
      button.closest('[data-image-field]').remove();
      renumberImages();
    });

    addImage.addEventListener('click', function () {
      const field = document.createElement('div');
      field.className = 'col-md-6 image-field';
      field.dataset.imageField = '';
      field.innerHTML = '<div class="image-preview-wrap mb-3">' +
        '<img class="image-preview" data-image-preview src="" alt="Product image preview">' +
        '<span class="image-number" data-image-number></span>' +
        '<button type="button" class="btn btn-light btn-sm remove-image shadow-sm" data-remove-image aria-label="Remove image"><i class="bi bi-trash"></i></button>' +
        '</div>' +
        '<label class="form-label" data-image-label></label>' +
        '<input type="url" name="imageUrls" class="form-control image-url" placeholder="https://...">';
      imageFields.appendChild(field);
      updateImageField(field);
      renumberImages();
      field.querySelector('.image-url').focus();
    });

    renumberImages();
  })();
</script>
