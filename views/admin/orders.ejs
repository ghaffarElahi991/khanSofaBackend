<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="text-uppercase small text-muted mb-1">Khan Sofa · Store management</p><h1 class="h2">Customer orders</h1><p class="text-muted mb-0">Review purchases, manage fulfillment, and add delivery tracking.</p></div><span class="badge bg-light text-dark border p-3"><%= total %> matching orders</span></div>
<form class="card card-body mb-4" method="GET"><div class="row g-3"><div class="col-md-7"><label for="search" class="form-label">Find an order</label><input id="search" class="form-control" name="search" value="<%= search %>" placeholder="Order number, customer name or email"></div><div class="col-md-3"><label for="status" class="form-label">Order status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option><% statuses.forEach(s => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s === 'CONFIRMED' ? 'Preparing / confirmed' : s.toLowerCase() %></option><% }) %></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Search</button></div></div></form>
<div class="card overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Order</th><th>Customer</th><th>Payment</th><th>Fulfillment</th><th>Total</th><th></th></tr></thead><tbody>
<% orders.forEach(order => { %><tr><td><a class="fw-semibold" href="/admin/orders/<%= order.id %>"><%= order.orderNumber %></a><div class="small text-muted"><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></div></td><td><%= order.customerName %><div class="small text-muted"><%= order.customerEmail %></div><span class="small text-muted"><%= order.userId ? 'Account customer' : 'Guest checkout' %></span></td><td><span class="badge <%= order.paymentStatus === 'PAID' ? 'bg-success-subtle text-success-emphasis' : 'bg-light text-dark' %>"><%= order.paymentStatus %></span></td><td><%= order.status %><div class="small text-muted"><%= order.trackingUrl ? 'Tracking added' : 'No tracking yet' %></div></td><td>$<%= Number(order.total).toFixed(2) %></td><td><a class="btn btn-outline-primary btn-sm" href="/admin/orders/<%= order.id %>">Manage order</a></td></tr><% }) %>
<% if (!orders.length) { %><tr><td colspan="6" class="text-center text-muted p-5">No orders match your search.</td></tr><% } %>
</tbody></table></div></div>
<nav aria-label="Order pages" class="d-flex justify-content-between align-items-center mt-4"><span class="text-muted small">Page <%= page %> of <%= Math.max(1,totalPages) %></span><div class="d-flex gap-2"><% if(page>1){ %><a class="btn btn-outline-secondary" href="?search=<%= encodeURIComponent(search) %>&status=<%= status %>&page=<%= page-1 %>">Previous</a><% } %><% if(page<totalPages){ %><a class="btn btn-outline-secondary" href="?search=<%= encodeURIComponent(search) %>&status=<%= status %>&page=<%= page+1 %>">Next</a><% } %></div></nav>
