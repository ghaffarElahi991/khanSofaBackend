<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1f392f">
  <title><%= title %> | Khan Sofa Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root { --admin-ink:#1c2823; --admin-green:#1f392f; --admin-green-2:#315446; --admin-canvas:#f5f3ee; --admin-paper:#fffdf9; --admin-line:#dfddd5; --admin-muted:#6d746f; --admin-accent:#aa603c; }
    * { box-sizing: border-box; }
    body { background:var(--admin-canvas); color:var(--admin-ink); font-family:"DM Sans",sans-serif; min-height:100vh; }
    h1,h2,h3,.admin-serif { font-family:"DM Serif Display",serif; letter-spacing:-.015em; }
    a { color:var(--admin-green-2); }
    .admin-navbar { background:var(--admin-green); border-bottom:1px solid rgba(255,255,255,.1); }
    .admin-navbar .navbar-brand { color:white; font-family:"DM Serif Display",serif; font-size:1.45rem; letter-spacing:.01em; }
    .brand-mark { align-items:center; background:#d7bc8b; border-radius:12px; color:var(--admin-green); display:inline-flex; font-family:"DM Sans",sans-serif; font-size:.78rem; font-weight:800; height:34px; justify-content:center; margin-right:.65rem; width:34px; }
    .admin-nav-link { border-radius:10px; color:rgba(255,255,255,.72); font-size:.92rem; font-weight:600; padding:.55rem .8rem; text-decoration:none; }
    .admin-nav-link:hover,.admin-nav-link.active { background:rgba(255,255,255,.1); color:white; }
    .admin-main { max-width:1440px; }
    .eyebrow { color:var(--admin-accent); font-size:.72rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
    .text-muted { color:var(--admin-muted)!important; }
    .card { background:var(--admin-paper); border:1px solid var(--admin-line); border-radius:16px; box-shadow:0 8px 28px rgba(31,57,47,.045); }
    .btn { border-radius:10px; font-weight:700; padding:.62rem 1rem; }
    .btn-sm { border-radius:8px; font-size:.82rem; padding:.4rem .65rem; }
    .btn-primary { background:var(--admin-green); border-color:var(--admin-green); }
    .btn-primary:hover,.btn-primary:focus { background:var(--admin-green-2); border-color:var(--admin-green-2); }
    .btn-outline-primary { border-color:#93a59d; color:var(--admin-green); }
    .btn-outline-primary:hover { background:var(--admin-green); border-color:var(--admin-green); }
    .btn-danger { background:#a43d36; border-color:#a43d36; }
    .btn-outline-danger { color:#a43d36; border-color:#d8aaa5; }
    .form-control,.form-select { background-color:#fff; border-color:#d6d3ca; border-radius:10px; min-height:44px; }
    textarea.form-control { min-height:auto; }
    .form-control:focus,.form-select:focus { border-color:#739083; box-shadow:0 0 0 .22rem rgba(49,84,70,.12); }
    .form-label { color:#34443d; font-size:.82rem; font-weight:700; margin-bottom:.42rem; }
    .form-text { color:#7c827e; font-size:.75rem; }
    .table>:not(caption)>*>* { border-bottom-color:#ebe8e1; padding:.9rem 1rem; }
    .table thead th { color:#727a75; font-size:.7rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase; }
    .alert { border:0; border-radius:12px; }
    .alert-success { background:#dfece5; color:#1e5d41; }
    .alert-danger { background:#f7e4e1; color:#84372f; }
    .badge { font-weight:700; letter-spacing:.01em; }
    .modal-content { border:0; border-radius:18px; box-shadow:0 24px 80px rgba(20,30,25,.2); }
    @media (max-width:767.98px) { .admin-main{padding-left:1rem;padding-right:1rem}.admin-navbar .container-fluid{align-items:flex-start}.admin-user-name{display:none} }
  </style>
</head>
<body>
  <% if (typeof adminName !== 'undefined' && adminName) { %>
    <nav class="navbar admin-navbar mb-4 py-3">
      <div class="container-fluid admin-main px-3 px-lg-4">
        <div class="d-flex align-items-center flex-wrap gap-2 gap-lg-4">
          <a class="navbar-brand me-2" href="/admin/products"><span class="brand-mark">KS</span>Khan Sofa</a>
          <div class="d-flex align-items-center gap-1">
            <a class="admin-nav-link <%= String(title).includes('Product') || title === 'Products' ? 'active' : '' %>" href="/admin/products"><i class="bi bi-grid me-1"></i> Products</a>
            <a class="admin-nav-link <%= String(title).includes('Order') || title === 'Orders' ? 'active' : '' %>" href="/admin/orders"><i class="bi bi-receipt me-1"></i> Orders</a>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a class="admin-nav-link d-none d-md-inline-flex" href="<%= storefrontUrl %>" target="_blank" rel="noreferrer"><i class="bi bi-box-arrow-up-right me-2"></i>View store</a>
          <span class="admin-user-name text-white-50 small px-2"><%= adminName %></span>
          <form action="/admin/logout" method="POST" class="m-0"><button type="submit" class="btn btn-sm btn-outline-light" aria-label="Log out"><i class="bi bi-box-arrow-right"></i><span class="d-none d-lg-inline ms-1">Logout</span></button></form>
        </div>
      </div>
    </nav>
  <% } %>
  <main class="container-fluid admin-main px-3 px-lg-4 pb-5"><%- body %></main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
