<a href="/admin/orders" class="text-decoration-none">← All orders</a>
<div class="d-flex flex-wrap justify-content-between align-items-center my-4 gap-3"><div><h1 class="h3 mb-1"><%= order.orderNumber %></h1><p class="text-muted mb-0"><%= new Date(order.createdAt).toLocaleString('en-GB') %> · <%= order.userId ? 'Account customer' : 'Guest checkout' %></p></div><span class="badge bg-light border text-dark p-3"><%= order.status %> · Payment <%= order.paymentStatus %></span></div>
<% if(saved){ %><div role="status" class="alert alert-success">Order status and tracking saved.</div><% } %>
<div class="row g-4"><div class="col-lg-8">
<section class="card card-body mb-4"><h2 class="h5 mb-3">Purchased items</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody><% order.items.forEach(item=>{ %><tr><td><div class="d-flex gap-3 align-items-center"><% if (/^https?:\/\//.test(item.product.primaryImageUrl || '')) { %><img src="<%= item.product.primaryImageUrl %>" alt="" width="64" height="56" style="object-fit:cover;background:#e8e2d7;border-radius:6px"><% } %><div><%= item.product.name %><div class="small text-muted"><%= [item.color,item.configuration].filter(Boolean).join(' · ') %></div></div></div></td><td><%= item.quantity %></td><td>$<%= Number(item.price).toFixed(2) %></td><td>$<%= (Number(item.price)*item.quantity).toFixed(2) %></td></tr><% }) %></tbody></table></div>
<dl class="row mb-0"><dt class="col-8">Subtotal</dt><dd class="col-4 text-end">$<%= Number(order.subtotal).toFixed(2) %></dd><dt class="col-8">Shipping</dt><dd class="col-4 text-end">$<%= Number(order.shippingCost).toFixed(2) %></dd><dt class="col-8">Discount</dt><dd class="col-4 text-end">−$<%= Number(order.discount).toFixed(2) %></dd><dt class="col-8 border-top pt-3">Order total</dt><dd class="col-4 border-top pt-3 text-end fw-bold">$<%= Number(order.total).toFixed(2) %></dd></dl></section>
<section class="card card-body mb-4"><h2 class="h5">Customer details</h2><p class="mb-1 fw-semibold"><%= order.customerName %></p><p class="mb-1"><%= order.customerEmail %></p><p><%= order.customerPhone %></p><div class="row"><div class="col-sm-6"><h3 class="h6">Delivery address</h3><address><%= order.shippingAddress %><br><%= [order.city,order.state,order.postalCode].filter(Boolean).join(', ') %><br><%= order.country %></address></div><div class="col-sm-6"><h3 class="h6">Billing address</h3><% if(order.billingSameAsShipping){ %><p>Same as delivery address</p><% } else { %><address><%= order.billingAddress %><br><%= [order.billingCity,order.billingState,order.billingPostalCode].filter(Boolean).join(', ') %><br><%= order.billingCountry %></address><% } %></div></div><% if(order.orderNotes){ %><h3 class="h6">Customer notes</h3><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= order.orderNotes %></p><% } %></section>
</div><div class="col-lg-4"><section class="card card-body mb-4"><h2 class="h5">Manage fulfillment</h2><form method="POST" action="/admin/orders/<%= order.id %>/tracking"><input type="hidden" name="csrf" value="<%= csrf %>"><label class="form-label mt-3" for="status">Order status</label><select id="status" name="status" class="form-select"><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= order.status===s?'selected':'' %>><%= s==='CONFIRMED'?'Preparing / confirmed':s.toLowerCase() %></option><% }) %></select><label class="form-label mt-3" for="trackingUrl">Courier tracking URL</label><input id="trackingUrl" class="form-control" type="url" name="trackingUrl" maxlength="2048" placeholder="https://courier.example/track/..." value="<%= order.trackingUrl || '' %>"><p class="form-text">Paste the full HTTPS tracking link. The customer’s website tracking link will redirect here once saved.</p><button class="btn btn-primary w-100 mt-2">Save changes</button><p class="small text-muted mt-3 mb-0">Status updates do not issue refunds, restock products, or send another email.</p></form></section>
<section class="card card-body mb-4"><h2 class="h5">Customer tracking link</h2><a style="overflow-wrap:anywhere" href="<%= siteUrl %>/track/<%= order.trackingToken %>" target="_blank" rel="noopener noreferrer"><%= siteUrl %>/track/<%= order.trackingToken %></a><p class="small text-muted mt-3 mb-0">This permanent link is included in payment emails and the customer’s order page.</p></section><section class="card card-body"><h2 class="h5">Payment</h2><p class="mb-1">Method: <%= order.paymentMethod %></p><p class="mb-0">Status: <%= order.paymentStatus %></p></section></div></div>
